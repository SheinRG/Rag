# Supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
# Optional: enables fast local JWT verification (skips a network call per request)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Groq
GROQ_API_KEY=your_groq_api_key
# Optional overrides (defaults: openai/gpt-oss-20b, low)
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low
# Groq currently ships no vision model; leave blank to disable /analyze-image
GROQ_VISION_MODEL=

# Cohere (Embeddings + Rerank)
COHERE_API_KEY=your_cohere_api_key

# Tavily (Web Search)
TAVILY_API_KEY=your_tavily_api_key

# App
ENVIRONMENT=development
MAX_FILE_SIZE_MB=20
ALLOWED_ORIGINS=http://localhost:5173

# Per-user quotas (optional overrides; defaults in config.py)
MAX_DOCUMENTS=100
MAX_STORAGE_MB=500
MAX_AI_CALLS_PER_DAY=200

# Ingestion watchdog
INGESTION_TIMEOUT_MINUTES=30
WATCHDOG_INTERVAL_SECONDS=300
